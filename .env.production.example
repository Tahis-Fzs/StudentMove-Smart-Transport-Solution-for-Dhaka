# Production Environment Template for Render.com
# Copy this to .env when deploying

APP_NAME="StudentMove"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app-name.onrender.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_DATABASE=Student-move

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Required for phone GPS / secure cookies behind HTTPS tunnel or production
SESSION_SECURE_COOKIE=true
# Admin panel password (/admin/login) — set a strong value in production
ADMIN_PASSWORD=

MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@studentmove.com"
MAIL_FROM_NAME="${APP_NAME}"

# SSLCommerz (hosted checkout — bKash, Nagad, cards)
# Register live store: https://developer.sslcommerz.com/registration/
# APP_URL must be HTTPS — callbacks use route('subscription.ssl.*')
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=false
SSLCOMMERZ_CURRENCY=BDT
# After deploy: php artisan sslcommerz:check --probe

DB_USERNAME=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
